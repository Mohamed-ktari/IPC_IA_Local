# Database — container name, not localhost
POSTGRES_USER=archai
POSTGRES_PASSWORD=changeme
POSTGRES_DB=architecture_ai
POSTGRES_HOST=postgres

CHROMA_HOST=chromadb
CHROMA_PORT=8000

REDIS_URL=redis://redis:6379

# Docling — GPU, per your RTX 5080 16GB. Flip to cpu if you see OOM/
# contention with Ollama under concurrent load — see note above.
# DOCLING_DEVICE=cuda

# ============================================================
# LLM — container name, not localhost
# ============================================================
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:14b-instruct-q4_K_M
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_TIMEOUT=60
OLLAMA_NUM_CTX=8192

DEFAULT_TEMPERATURE=0.1
DEFAULT_MAX_TOKENS=4096

# ============================================================
# RAG
# ============================================================
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=10
RETRIEVAL_MIN_SCORE=0.35
MAX_CONTEXT_WORDS=4000
SEMANTIC_WEIGHT=0.3
BM25_WEIGHT=0.7

# ============================================================
# DOCUMENTS
# ============================================================
PDF_MAX_PAGES=200

# ============================================================
# SECURITY — change these for real production use
# ============================================================
SECRET_KEY=change-this-in-production
ALLOWED_ORIGINS=["https://your-frontend-domain.example"]

DEBUG=False